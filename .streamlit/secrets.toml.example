# Streamlit Community Cloud Secrets Example
# Copy this content into your Streamlit Cloud App Settings -> Secrets

# Optional: Cloud PostgreSQL database (e.g. Neon, Supabase, AWS RDS, Cloud SQL)
# If omitted, Supply Prescript automatically runs using embedded SQLite with zero setup!
# DATABASE_URL = "postgresql+psycopg://username:password@ep-your-db.neon.tech/supply_prescript?sslmode=require"

# Optional: Remote FastAPI Base URL
# If omitted or offline, the dashboard automatically invokes the Python analytical engines directly!
API_BASE_URL = "http://127.0.0.1:8000/api"

ENVIRONMENT = "production"

