# Database Configuration (PostgreSQL in production / Docker, or SQLite for local dev)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/supply_prescript
# DATABASE_URL=sqlite:///supply_prescript_seed.db

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Frontend & Dashboard Configuration
FRONTEND_URL=http://localhost:8501
FRONTEND_PORT=8501

# Model & Engine Configurations
MODEL_PATH=models/delay_prediction/delay_classifier.joblib
METADATA_PATH=models/delay_prediction/model_metadata.json
RISK_CONFIG_PATH=config/risk_config.yaml
OPTIMIZATION_CONFIG_PATH=config/optimization_config.yaml

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
